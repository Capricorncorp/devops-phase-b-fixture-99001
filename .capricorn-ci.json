{
  "version": 1,
  "steps": [
    { "name": "fixture-context", "run": "test -s server.cjs && test -s Dockerfile", "timeout": 60 },
    { "name": "owned-retry-gate", "run": "git ls-remote --exit-code origin refs/tags/whole-suite-retry-ready-20261014", "timeout": 30 }
  ],
  "image": { "name": "whole-suite-proof", "builder": "dockerfile", "dockerfile": "Dockerfile", "cache": true },
  "deploy": {
    "provider": "swarm",
    "target": {
      "serviceName": "whole-suite-proof",
      "replicas": 1,
      "ingressHost": "whole-suite-proof-2.apps.capricorncorp.com",
      "limitCpu": "0.5",
      "limitMemory": "128M",
      "env": { "PORT": "3000", "ACCEPTANCE_VERSION": "20261014-v1" }
    }
  }
}
