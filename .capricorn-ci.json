{
  "version": 1,
  "steps": [
    {
      "name": "Check disposable delivery proof source",
      "run": "test -s server.js && test -s Dockerfile",
      "timeout": 30
    }
  ],
  "image": {
    "name": "delivery-proof-20261021",
    "builder": "dockerfile",
    "dockerfile": "Dockerfile",
    "context": ".",
    "cache": false
  },
  "deploy": {
    "provider": "swarm",
    "target": {
      "serviceName": "delivery-proof-20261021",
      "replicas": 3,
      "ingressHost": "auto",
      "limitCpu": "0.1",
      "limitMemory": "128M",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "DELIVERY_PROOF_REVISION": "g24-20261029-rollback-current",
        "DELIVERY_PROOF_HEALTH": "ok"
      },
      "delivery": {
        "strategy": "blue-green",
        "batchSize": 3,
        "monitorSeconds": 20,
        "healthPath": "/health"
      }
    }
  }
}
